#include <bits/stdc++.h>
using namespace std;

void print_s(int n, int k){
    if(n > 0){
        cout << k << '\n';
        print_s(n-1, k+1);
    }
}

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{};
    cin >> n;

    print_s(n,1);
}
