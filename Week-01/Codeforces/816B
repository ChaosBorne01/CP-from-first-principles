#include <bits/stdc++.h>
using namespace std;

#define SIZE 200002

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, k{}, q{};
    cin >> n >> k >> q;

    vector<int> diff(SIZE);
    while(n--){
        int l{}, r{};
        cin >> l >> r;

        diff[l]++;
        diff[r+1]--;
    }

    vector<int> occ(SIZE-1);
    for(int i = 1; i < SIZE-1; ++i) occ[i] = occ[i-1] + diff[i];

    vector<int> admissible(SIZE-1);
    for(int i = 1; i < SIZE-1; ++i) admissible[i] = admissible[i-1] + (occ[i] >= k);

    while(q--){
        int a{}, b{};
        cin >> a >> b;

        cout << admissible[b] - admissible[a-1] << '\n';
    }
}