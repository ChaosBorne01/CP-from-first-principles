#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, q{};
    cin >> n >> q;

    vector<int> a(n);
    for(int i = 0; i < n; ++i) cin >> a[i];

    while(q--){
        string s;
        cin >> s;

        if(s == "pop_back") a.pop_back();
        else if(s == "front") cout << a[0] << '\n';
        else if(s == "back") cout << a[a.size()-1] << '\n';
        else if(s == "sort"){
            int l{}, r{};
            cin >> l >> r;

            sort(a.begin() + l - 1, a.begin() + r);
        }
        else if(s == "reverse"){
            int l{}, r{};
            cin >> l >> r;

            reverse(a.begin() + l - 1, a.begin() + r);
        }
        else if(s == "print"){
            int pos{};
            cin >> pos;

            cout << a[pos-1] << '\n';
        }
        else{
            int x{};
            cin >> x;
            a.push_back(x);
        }
    }
}
