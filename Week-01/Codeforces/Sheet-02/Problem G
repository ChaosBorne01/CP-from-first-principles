#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, m{}, q{};
    cin >> n >> m >> q;

    vector<vector<long long>> matrix(n, vector<long long>(m, 0));
    for(int i = 0; i < n; ++i){
        for(int j = 0; j < m; ++j) cin >> matrix[i][j];
    }

    vector<vector<long long>> sum(n+1, vector<long long>(m+1));
    for(int i = 1; i < n+1; ++i) sum[i][1] = matrix[i-1][0] + sum[i-1][1];
    for(int j = 1; j < m+1; ++j) sum[1][j] = matrix[0][j-1] + sum[1][j-1];

    for(int i = 2; i < n+1; ++i){
        for(int j = 2; j < m+1; ++j) sum[i][j] = sum[i-1][j] + sum[i][j-1] + matrix[i-1][j-1] - sum[i-1][j-1];
    }

    while(q--){
        int x1{}, x2{}, y1{}, y2{};
        cin >> x1 >> y1 >> x2 >> y2;

        cout << sum[x2][y2] + sum[x1-1][y1-1] - sum[x1-1][y2] - sum[x2][y1-1] << '\n';
    }
}
