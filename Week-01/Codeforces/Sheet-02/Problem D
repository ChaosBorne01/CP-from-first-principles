#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, m{};
    cin >> n >> m;

    vector<int> a(n);
    for(int i = 0; i < n; ++i) cin >> a[i];

    sort(a.begin(), a.end());
    int target{-m};

    for(int i = 0; i < n; ++i){
        if(a[i] == target) target++;
        else if(a[i] < target) continue;
        else break;
    }

    cout << target << '\n';
}
