#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, q{};
    cin >> n >> q;

    vector<int> a(n);
    for(int i = 0; i < n; ++i) cin >> a[i];
    
    vector<long long> sum(n+1);
    sum[0] = 0;
    for(int i = 1; i < n+1; ++i) sum[i] = sum[i-1] + a[i-1];

    while(q--){
        int l{}, r{};
        cin >> l >> r;
        l--;

        cout << sum[r]-sum[l] << '\n';
    }
}
