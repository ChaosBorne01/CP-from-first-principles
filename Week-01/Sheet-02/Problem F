#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, q{};
    cin >> n >> q;

    vector<long long> a(n);
    for(int i = 0; i < n; ++i) cin >> a[i];

    vector<long long> changes(n+1);
    while(q--){
        int l{}, r{}, val;
        cin >> l >> r >> val;
        l--;

        changes[l] += val;
        changes[r] -= val;
    }

    long long tmp{};
    for(int i = 0; i < n; ++i){
        tmp += changes[i];
        a[i] += tmp;
    }

    for(int i = 0; i < n; ++i) cout << a[i] << " ";
    cout << '\n';
}
