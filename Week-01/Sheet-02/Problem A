#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, q{};
    cin >> n >> q;

    map<int, int> occ;

    while(q--){
        int z{}, x{};
        cin >> z >> x;

        if(z == 1) occ[x]++;
        else cout << occ[x] << '\n';
    }
}
