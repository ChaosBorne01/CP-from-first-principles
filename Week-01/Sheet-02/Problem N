#include <bits/stdc++.h>
using namespace std;

struct Interval{
    int l{};
    int r{};
};

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{};
    cin >> n;

    vector<pair<int,int>> coord(n);
    for(int i = 0; i < n; ++i){
        cin >> coord[i].first;
        cin >> coord[i].second;
    }

    sort(coord.begin(), coord.end());

    for(int i = 0; i < n; ++i){
        int j = i;
        int i1{coord[i].first}, i2{coord[i].second};
        for(; j < n; ++j){
            if(j < n-1 && coord[j+1].first <= i2){
                i2 = max(i2, coord[j+1].second);
                continue;
            }
            cout << i1 << " " << i2 << '\n';
            i = j;
            break;
        }
    }
}
