#include <bits/stdc++.h>
using namespace std;

int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);

    int n{}, t{};
    cin >> n >> t;

    vector<int> a(n);
    for(auto& val : a) cin >> val;

    int l{};
    int max_books{}, time{};

    for(; l < n; ++l){
        if(a[l] <= t){
            time += a[l];
            max_books = 1;
            break;
        }
    }
    
    int r{l+1};
    for(; r < n; ++r){
        time += a[r];
        if(time > t){
            time -= a[r];
            r--;
            max_books = max(max_books, r-l+1);
            time -= a[l];
            l++;
            continue;
        }

        if(r == n-1){
            max_books = max(max_books, r-l+1);
        }
    }

    cout << max_books << '\n';
}