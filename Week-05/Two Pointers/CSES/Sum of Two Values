#include <bits/stdc++.h>
using namespace std;
 
int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);
 
    int n{}, x{};
    cin >> n >> x;
 
    vector<int> a(n);
    for(auto& val : a) cin >> val;
 
    map<int, int> idx;
    
    for(int i = 0; i < n; ++i){
        int comp{x - a[i]};
        if(idx.find(comp) != idx.end()){
            cout << i+1 << " " << idx[comp] << '\n';
            return 0;
        }
 
        idx[a[i]] = i+1;
    }
 
    cout << "IMPOSSIBLE" << '\n';
}
