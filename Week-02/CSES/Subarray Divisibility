#include <bits/stdc++.h>
using namespace std;
 
int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);
 
    long long n{};
    cin >> n;
 
    vector<long long> a(n);
    for(auto& i : a) cin >> i;
 
    vector<long long> preSum(n+1);
    for(int i = 1; i < n+1; ++i) preSum[i] = preSum[i-1] + a[i-1];
 
    unordered_map<long long,int> occ;
    occ.rehash(n);
    
    long long subArrays{};
    for(int i = 0; i < n+1; ++i){
        auto r{(n + preSum[i]%n)%n};
        subArrays += occ[r];
        occ[r]++;
    }
 
    cout << subArrays << '\n';
}
