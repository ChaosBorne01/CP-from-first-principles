#include <bits/stdc++.h>
using namespace std;
 
int main(){
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);
 
    long long n{}, x{};
    cin >> n >> x;
 
    vector<long long> a(n);
    for(auto& i : a) cin >> i;
 
    vector<long long> preSum(n+1);
    for(int i = 1; i < n+1; ++i) preSum[i] = preSum[i-1] + a[i-1];
 
    map<long long,int> occ;
    
    long long subArrays{};
    for(int i = 0; i < n+1; ++i){
        subArrays += occ[preSum[i] - x];
        occ[preSum[i]]++;
    }
 
    cout << subArrays << '\n';
}